<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#7d7d7d">

    <TextView
        android:id="@+id/tvExpression"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="8dp"
        android:text=""
        android:textColor="#8E8E93FF"
        android:textSize="16sp"
        android:gravity="end"
        app:layout_constraintTop_toTopOf="@id/tvResult"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:id="@+id/tvResult"
        android:layout_width="380dp"
        android:layout_height="100dp"
        android:background="@drawable/bg_display"
        android:gravity="end|center_vertical"
        android:includeFontPadding="false"
        android:paddingHorizontal="20dp"
        android:text="0"
        android:textColor="#000000"
        android:textSize="48sp"
        app:layout_constraintBottom_toTopOf="@id/gridButtons"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.483"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.778" />

    <GridLayout
        android:id="@+id/gridButtons"
        android:layout_width="411dp"
        android:layout_height="409dp"
        android:layout_marginBottom="4dp"
        android:columnCount="4"
        android:padding="12dp"
        android:rowCount="5"
        android:useDefaultMargins="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent">



        <Button
            android:id="@+id/backspace"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:backgroundTint="#FFFFFFCC"
            android:text="⌫"
            android:textColor="#000000" />

        <Button
            android:id="@+id/btnClear"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:backgroundTint="#FFFFFFCC"
            android:text="C"
            android:textColor="#000000" />

        <Button
            android:id="@+id/btnPercent"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:backgroundTint="#FFFFFFCC"
            android:text="%"
            android:textColor="#000000" />

        <Button
            android:id="@+id/btnDiv"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:backgroundTint="#FFFFFFCC"
            android:text="÷"
            android:textColor="#000000" />

        <Button
            android:id="@+id/btn7"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:backgroundTint="#FFFFFFCC"
            android:text="7"
            android:textColor="#000000" />

        <Button
            android:id="@+id/btn8"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:backgroundTint="#FFFFFFCC"
            android:text="8"
            android:textColor="#000000" />

        <Button
            android:id="@+id/btn9"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:backgroundTint="#FFFFFFCC"
            android:text="9"
            android:textColor="#000000" />

        <Button
            android:id="@+id/btnMul"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:backgroundTint="#FFFFFFCC"
            android:text="×"
            android:textColor="#000000" />

        <Button
            android:id="@+id/btn4"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:backgroundTint="#FFFFFFCC"
            android:text="4"
            android:textColor="#000000" />

        <Button
            android:id="@+id/btn5"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:backgroundTint="#FFFFFFCC"
            android:text="5"
            android:textColor="#000000" />

        <Button
            android:id="@+id/btn6"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:backgroundTint="#FFFFFFCC"
            android:text="6"
            android:textColor="#000000" />

        <Button
            android:id="@+id/btnSub"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:backgroundTint="#FFFFFFCC"
            android:text="−"
            android:textColor="#000000" />

        <Button
            android:id="@+id/btn1"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:backgroundTint="#FFFFFFCC"
            android:text="1"
            android:textColor="#000000" />

        <Button
            android:id="@+id/btn2"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:backgroundTint="#FFFFFFCC"
            android:text="2"
            android:textColor="#000000" />

        <Button
            android:id="@+id/btn3"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:backgroundTint="#FFFFFFCC"
            android:text="3"
            android:textColor="#000000" />

        <Button
            android:id="@+id/btnAdd"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:backgroundTint="#FFFFFFCC"
            android:text="+"
            android:textColor="#000000" />

        <Button
            android:id="@+id/btnSign"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:backgroundTint="#FFFFFFCC"
            android:text="+/−"
            android:textColor="#000000" />

        <Button
            android:id="@+id/btn0"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:backgroundTint="#FFFFFFCC"
            android:text="0"
            android:textColor="#000000" />

        <Button
            android:id="@+id/btnDot"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:backgroundTint="#FFFFFFCC"
            android:text="."
            android:textColor="#000000" />

        <Button
            android:id="@+id/btnEq"
            android:layout_rowWeight="1"
            android:layout_columnWeight="1"
            android:backgroundTint="#FFFFFFCC"
            android:text="="
            android:textColor="#000000" />

    </GridLayout>

</androidx.constraintlayout.widget.ConstraintLayout>